/* ---------------- single-pass bilinear area variants ---------------------------------- */

float4 PSDrawK4AreaBFrag(FragData f_in) : TARGET
{
	return DrawK4AreaB(f_in.uv);
}

float4 PSDrawK4AreaBMultiply(FragData f_in) : TARGET
{
	float4 rgba = DrawK4AreaB(f_in.uv);
	rgba.rgb *= multiplier;
	return rgba;
}

float4 PSDrawK4AreaBTonemap(FragData f_in) : TARGET
{
	float4 rgba = DrawK4AreaB(f_in.uv);
	rgba.rgb = rec709_to_rec2020(rgba.rgb);
	rgba.rgb = reinhard(rgba.rgb);
	rgba.rgb = rec2020_to_rec709(rgba.rgb);
	return rgba;
}

