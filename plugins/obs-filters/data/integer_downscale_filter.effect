/* ---------------- techniques ----------------------------------------------------------- */

technique K2Area { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2Area(f_in); } }
technique K2AreaMultiply { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2AreaMultiply(f_in); } }
technique K2AreaTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2AreaTonemap(f_in); } }
technique K2AreaMultiplyTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2AreaMultiplyTonemap(f_in); } }

technique K2Text { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2Text(f_in); } }
technique K2TextMultiply { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2TextMultiply(f_in); } }
technique K2TextTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2TextTonemap(f_in); } }
technique K2TextMultiplyTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2TextMultiplyTonemap(f_in); } }

technique K2Lanc { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2Lanc(f_in); } }
technique K2LancMultiply { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2LancMultiply(f_in); } }
technique K2LancTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2LancTonemap(f_in); } }
technique K2LancMultiplyTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK2LancMultiplyTonemap(f_in); } }

technique K3Area { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3Area(f_in); } }
technique K3AreaMultiply { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3AreaMultiply(f_in); } }
technique K3AreaTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3AreaTonemap(f_in); } }
