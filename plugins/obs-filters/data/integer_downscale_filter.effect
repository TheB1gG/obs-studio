technique K3TextTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3TextTonemap(f_in); } }
technique K3TextMultiplyTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3TextMultiplyTonemap(f_in); } }

technique K3Lanc { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3Lanc(f_in); } }
technique K3LancMultiply { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3LancMultiply(f_in); } }
technique K3LancTonemap { pass { vertex_shader = VSDefault(v_in); pixel_shader = PSDrawK3LancTonemap(f_in); } }
